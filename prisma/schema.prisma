generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── Race Day ──────────────────────────────────────────────

model RaceDay {
  id           String   @id @default(cuid())
  date         String   // ISO date
  venue        String
  raceCount    Int
  distances    String
  type         String   // Thoroughbred | Pony Racing | Mixed Breed & Thoroughbred
  status       String   @default("upcoming") // upcoming | live | completed
  featuredRace String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model RaceCard {
  id     String @id @default(cuid())
  club   String // RSTC | HKJC | SLTC | AUS | STC
  label  String
  url    String
  type   String // pdf | external
  colour String @default("blue")
}

model RaceResult {
  id        String   @id @default(cuid())
  date      String
  venue     String
  resultUrl String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  highlights ResultHighlight[]
}

model ResultHighlight {
  id         String     @id @default(cuid())
  race       Int
  horseName  String
  position   Int
  time       String?
  resultId   String
  result     RaceResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
}

model RaceAnalysis {
  id    String @id @default(cuid())
  club  String
  label String
  url   String
}

// ── The Club ──────────────────────────────────────────────

model HistoryEvent {
  id          String @id @default(cuid())
  year        String
  title       String
  description String
  sortOrder   Int    @default(0)
}

model CommitteeMember {
  id   String @id @default(cuid())
  role String
  name String
}

// ── Own & Breed ──────────────────────────────────────────

model Stallion {
  id      String @id @default(cuid())
  name    String
  breed   String
  yob     Int
  color   String
  origin  String
  summary String
}

model PdfDocument {
  id          String @id @default(cuid())
  title       String
  category    String // breeding-regs | rules | prohibited | commingling | other
  url         String
  description String
}

// ── Events / Feed ─────────────────────────────────────────

model FeedItem {
  id          String  @id @default(cuid())
  category    String  // race | derby | club | own | betting | results
  title       String
  date        String
  description String
  href        String
  featured    Boolean @default(false)
  sortOrder   Int     @default(0)
}

// ── Umamusume / Derby ─────────────────────────────────────

model DerbyEvent {
  id          String @id @default(cuid())
  title       String
  subtitle    String?
  date        String
  venue       String
  description String
  activities  String // JSON array stored as string
  partners    String // JSON array stored as string
  status      String @default("upcoming") // upcoming | completed
  type        String @default("crossover") // crossover | viewing | community
}

model BridgeContent {
  id                    String @id @default(cuid())
  umamusumeConcept      String
  realRacingEquivalent  String
  explanation           String
  sortOrder             Int    @default(0)
}

// ── User (Phase 4+) ──────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  discordId     String?  @unique
  displayName   String
  email         String?  @unique
  avatarUrl     String?
  trackedRaces  String   @default("[]") // JSON array of RaceDay IDs
  trackedHorses String   @default("[]") // JSON array of Stallion IDs
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
